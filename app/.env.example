# =============================================================================
# AI Simultaneous Interpretation Assistant — Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials.

# Server port
PORT=3000

# ASR WebSocket endpoint (iFlytek realtime ASR)
ASR_BASE_URL=wss://rtasr.xfyun.cn/v1/asr/ws

# API credentials (from iFlytek console / MyTranslate)
TRANSLATE_APP_ID=your_app_id
TRANSLATE_APP_SECRET=your_app_secret

# (Optional) Anthropic API key for LLM-assisted refinement
ANTHROPIC_API_KEY=
